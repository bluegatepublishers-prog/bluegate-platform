generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School?
  teacher   Teacher?
}

model Teacher {
  id              String           @id @default(cuid())
  userId          String           @unique
  schoolName      String
  schoolId        String?
  designation     String
  subject         String
  classes         String
  verified        Boolean          @default(false)
  bookmarks       Bookmark[]
  downloads       Download[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school          School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  aiGenerations   AiGeneration[]
  promptTemplates PromptTemplate[]

  @@index([schoolId])
}

model AiGeneration {
  id        String   @id @default(cuid())
  teacherId String
  tool      String
  title     String
  prompt    String
  output    String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  tool        String
  prompt      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, updatedAt])
}

model School {
  id                 String              @id @default(cuid())
  userId             String              @unique
  schoolName         String
  city               String
  state              String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspectionRequests InspectionRequest[]
  teachers           Teacher[]
}

model InspectionRequest {
  id          String           @id @default(cuid())
  schoolName  String
  teacherName String
  designation String
  mobile      String
  email       String
  state       String
  city        String
  address     String
  message     String?
  bookId      String?
  bookTitle   String
  bookClass   String
  bookSubject String
  bookSeries  String?
  status      InspectionStatus @default(NEW)
  notes       String?
  schoolId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
}

model Class {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model BookSeries {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]
}

model Book {
  id               String      @id @default(cuid())
  title            String
  author           String?
  subtitle         String?
  slug             String      @unique
  isbn             String?
  description      String?
  coverImage       String?
  samplePdf        String?
  featured         Boolean     @default(false)
  published        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  classId          String
  subjectId        String
  seriesId         String?
  aboutBook        String?
  binding          String?
  board            String?
  dimensions       String?
  edition          String?
  features         String[]    @default([])
  galleryImages    String[]    @default([])
  language         String?
  learningOutcomes String[]    @default([])
  pages            Int?
  price            Decimal?    @db.Decimal(10, 2)
  publicationYear  String?
  publisher        String?
  tableOfContents  String[]    @default([])
  weight           String?
  seoTitle         String?
  seoDescription   String?
  keywords         String[]    @default([])
  class            Class       @relation(fields: [classId], references: [id])
  series           BookSeries? @relation(fields: [seriesId], references: [id])
  subject          Subject     @relation(fields: [subjectId], references: [id])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String
  subject     String
  classLevel  String
  type        ResourceType
  fileUrl     String
  thumbnail   String?
  featured    Boolean      @default(false)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookmarks   Bookmark[]
  downloads   Download[]
}

model Download {
  id           String   @id @default(cuid())
  teacherId    String
  resourceId   String
  downloadedAt DateTime @default(now())
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id         String   @id @default(cuid())
  teacherId  String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  TEACHER
  SCHOOL
}

enum ResourceType {
  PDF
  PPT
  DOC
  VIDEO
  ZIP
}

enum InspectionStatus {
  NEW
  CONTACTED
  APPROVED
  DISPATCHED
  CLOSED
}
