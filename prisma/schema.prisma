model GapAnalysisRun {
  id                      String                       @id @default(cuid())
  runKey                  String                       @unique
  publisherId             String
  schoolId                String
  studentId               String
  academicYearId          String
  policyVersion           String
  scope                   String                       @default("STUDENT_YEAR")
  status                  GapAnalysisRunStatus         @default(COMPLETED)
  detectedCount           Int                          @default(0)
  resolvedCount           Int                          @default(0)
  sufficientEvidenceCount Int                          @default(0)
  startedAt               DateTime                     @default(now())
  completedAt             DateTime?
  createdAt               DateTime                     @default(now())
  publisher               Publisher                    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  school                  School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student                 Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear            AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  latestGaps              StudentLearningGap[]
  evidence                StudentLearningGapEvidence[]

  @@index([publisherId, academicYearId, createdAt])
  @@index([schoolId, academicYearId, createdAt])
  @@index([studentId, academicYearId, createdAt])
}

model StudentLearningGap {
  id                 String                       @id @default(cuid())
  publisherId        String
  schoolId           String
  studentId          String
  academicYearId     String
  subjectId          String?
  bookId             String?
  chapterId          String?
  skillKey           String?
  skillLabel         String?
  dimension          GapDimension
  severity           GapSeverity
  status             GapStatus                    @default(OPEN)
  source             GapDetectionSource           @default(SYSTEM_RULE)
  policyVersion      String
  score              Float?
  evidenceCount      Int
  baselineSampleSize Int                          @default(0)
  detectionKey       String
  activeKey          String?                      @unique
  latestRunId        String
  firstDetectedAt    DateTime                     @default(now())
  lastDetectedAt     DateTime                     @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  dismissedAt        DateTime?
  lastReviewedById   String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  publisher          Publisher                    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  school             School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student            Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subject            Subject?                     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  book               Book?                        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  chapter            BookChapter?                 @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  latestRun          GapAnalysisRun               @relation(fields: [latestRunId], references: [id], onDelete: Restrict)
  lastReviewedBy     User?                        @relation("GapLastReviewer", fields: [lastReviewedById], references: [id], onDelete: SetNull)
  evidence           StudentLearningGapEvidence[]
  reviews            StudentLearningGapReview[]
  remedialPlans      RemedialPlan[]

  @@index([studentId, academicYearId, status])
  @@index([schoolId, academicYearId, status])
  @@index([publisherId, status])
  @@index([subjectId, status])
  @@index([chapterId, status])
  @@index([dimension, skillKey, status])
  @@index([detectionKey, createdAt])
}

model StudentLearningGapEvidence {
  id                  String             @id @default(cuid())
  gapId               String
  runId               String
  evidenceType        GapEvidenceType
  metricKey           String
  metricValue         Float
  thresholdValue      Float?
  sampleSize          Int?
  observedAt          DateTime
  sourceAnalyticsType String
  sourceAnalyticsId   String
  createdAt           DateTime           @default(now())
  gap                 StudentLearningGap @relation(fields: [gapId], references: [id], onDelete: Restrict)
  run                 GapAnalysisRun     @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([gapId, runId, metricKey, sourceAnalyticsId])
  @@index([gapId, observedAt])
  @@index([runId])
}

model StudentLearningGapReview {
  id          String             @id @default(cuid())
  gapId       String
  actorUserId String
  teacherId   String
  action      GapReviewAction
  reason      String?
  createdAt   DateTime           @default(now())
  gap         StudentLearningGap @relation(fields: [gapId], references: [id], onDelete: Restrict)
  actor       User               @relation("GapReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([gapId, createdAt])
  @@index([teacherId, createdAt])
}

model RemedialPlan {
  id                        String                   @id @default(cuid())
  publisherId               String
  schoolId                  String
  studentId                 String
  academicYearId            String
  gapId                     String
  policyVersion             String
  recommendationFingerprint String
  generationKey             String                   @unique
  activeKey                 String?                  @unique
  status                    RemedialPlanStatus       @default(DRAFT)
  priority                  Int
  dueAt                     DateTime
  reviewedAt                DateTime?
  reviewedById              String?
  activatedAt               DateTime?
  completedAt               DateTime?
  closedAt                  DateTime?
  supersededAt              DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  publisher                 Publisher                @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  school                    School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student                   Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear              AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gap                       StudentLearningGap       @relation(fields: [gapId], references: [id], onDelete: Restrict)
  reviewedBy                User?                    @relation("RemedialPlanReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  recommendations           RemedialRecommendation[]
  steps                     RemedialStep[]
  reviews                   RemedialPlanReview[]

  @@index([studentId, academicYearId, status])
  @@index([schoolId, academicYearId, status, dueAt])
  @@index([publisherId, status, createdAt])
  @@index([gapId, createdAt])
}

model RemedialRecommendation {
  id            String                     @id @default(cuid())
  planId        String
  sequence      Int
  type          RemedialRecommendationType
  labelSnapshot String
  required      Boolean                    @default(true)
  bookId        String?
  chapterId     String?
  resourceId    String?
  assessmentId  String?
  pageStart     Int?
  pageEnd       Int?
  createdAt     DateTime                   @default(now())
  plan          RemedialPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  book          Book?                      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  chapter       BookChapter?               @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  resource      Resource?                  @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assessment    Assessment?                @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  step          RemedialStep?

  @@unique([planId, sequence])
  @@index([type, bookId, chapterId])
  @@index([resourceId])
  @@index([assessmentId])
}

model RemedialStep {
  id               String                 @id @default(cuid())
  planId           String
  recommendationId String                 @unique
  sequence         Int
  status           RemedialStepStatus     @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  skippedAt        DateTime?
  teacherClosedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  plan             RemedialPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  recommendation   RemedialRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  events           RemedialStepEvent[]

  @@unique([planId, sequence])
  @@index([planId, status])
}

model RemedialStepEvent {
  id          String              @id @default(cuid())
  stepId      String
  actorUserId String?
  fromStatus  RemedialStepStatus?
  toStatus    RemedialStepStatus
  sourceType  String
  sourceId    String?
  createdAt   DateTime            @default(now())
  step        RemedialStep        @relation(fields: [stepId], references: [id], onDelete: Restrict)
  actor       User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([stepId, createdAt])
  @@index([actorUserId, createdAt])
}

model RemedialPlanReview {
  id          String               @id @default(cuid())
  planId      String
  actorUserId String
  teacherId   String
  action      RemedialReviewAction
  reason      String?
  createdAt   DateTime             @default(now())
  plan        RemedialPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  actor       User                 @relation("RemedialReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  teacher     Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([planId, createdAt])
  @@index([teacherId, createdAt])
}

