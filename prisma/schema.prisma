generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  name                        String
  email                       String                       @unique
  username                    String?                      @unique
  password                    String
  active                      Boolean                      @default(true)
  mustChangePassword          Boolean                      @default(false)
  passwordChangedAt           DateTime?
  phone                       String?
  role                        UserRole
  publisherId                 String?
  emailVerifiedAt             DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  school                      School?
  teacher                     Teacher?
  student                     Student?
  requestedBookAdoptions      SchoolBookAdoption[]         @relation("BookAdoptionRequester")
  reviewedBookAdoptions       SchoolBookAdoption[]         @relation("BookAdoptionReviewer")
  grantedStudentAccess        StudentAccessGrant[]         @relation("StudentAccessGrantGranter")
  createdAssessments          Assessment[]                 @relation("AssessmentCreator")
  reviewedAssessmentResponses AssessmentResponse[]         @relation("AssessmentResponseReviewer")
  publisher                   Publisher?                   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  gapReviews                  StudentLearningGapReview[]   @relation("GapReviewActor")
  lastReviewedGaps            StudentLearningGap[]         @relation("GapLastReviewer")
  reviewedRemedialPlans       RemedialPlan[]               @relation("RemedialPlanReviewer")
  remedialStepEvents          RemedialStepEvent[]
  remedialReviews             RemedialPlanReview[]         @relation("RemedialReviewActor")
  schoolOnboardingReviews     SchoolOnboardingReview[]     @relation("SchoolOnboardingReviewer")
  teacherRequestReviews       TeacherSchoolRequest[]       @relation("TeacherRequestReviewer")
  activationCodesCreated      StudentActivationCode[]      @relation("ActivationCodeCreator")
  activationCodesUsed         StudentActivationCode[]      @relation("ActivationCodeUser")
  mentor                      Mentor?
  parent                      Parent?
  mentorAssignmentsCreated    MentorStudentAssignment[]    @relation("MentorAssignmentCreator")
  mentorAssignmentsRevoked    MentorStudentAssignment[]    @relation("MentorAssignmentRevoker")
  mentorSessionsCreated       MentorSession[]              @relation("MentorSessionCreator")
  mentorActivities            MentorActivity[]             @relation("MentorActivityActor")
  parentInvitationsCreated    ParentInvitation[]           @relation("ParentInvitationCreator")
  parentInvitationsUsed       ParentInvitation[]           @relation("ParentInvitationUser")
  parentRelationshipsApproved ParentStudentRelationship[]  @relation("ParentRelationshipApprover")
  parentRelationshipsRevoked  ParentStudentRelationship[]  @relation("ParentRelationshipRevoker")
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges     PasswordResetChallenge[]
  staffMemberships            SchoolStaffMembership[]
  assignedSchoolBooks         SchoolBookEntitlement[]      @relation("SchoolBookEntitlementAssigner")
  pausedSchoolBooks           SchoolBookEntitlement[]      @relation("SchoolBookEntitlementPauser")
  revokedSchoolBooks          SchoolBookEntitlement[]      @relation("SchoolBookEntitlementRevoker")
  restoredSchoolBooks         SchoolBookEntitlement[]      @relation("SchoolBookEntitlementRestorer")
  archivedSchoolBooks         SchoolBookEntitlement[]      @relation("SchoolBookEntitlementArchiver")
  assignedSchoolResources     SchoolResourceEntitlement[]  @relation("SchoolResourceEntitlementAssigner")
  pausedSchoolResources       SchoolResourceEntitlement[]  @relation("SchoolResourceEntitlementPauser")
  revokedSchoolResources      SchoolResourceEntitlement[]  @relation("SchoolResourceEntitlementRevoker")
  restoredSchoolResources     SchoolResourceEntitlement[]  @relation("SchoolResourceEntitlementRestorer")
  archivedSchoolResources     SchoolResourceEntitlement[]  @relation("SchoolResourceEntitlementArchiver")
  createdQrCodes              DynamicQrCode[]               @relation("QrCodeCreatedBy")
  suspendedQrCodes            DynamicQrCode[]               @relation("QrCodeSuspendedBy")
  createdQrDestinations       QrDestination[]                @relation("QrDestinationCreatedBy")
  approvedQrDestinations      QrDestination[]                @relation("QrDestinationApprovedBy")
  changedQrRedirectRevisions  QrRedirectRevision[]            @relation("QrRevisionChangedBy")

  @@index([publisherId, role])
  @@index([role, active])
}

model Publisher {
  id                         String                      @id @default(cuid())
  name                       String
  shortName                  String?
  slug                       String                      @unique
  active                     Boolean                     @default(true)
  logoUrl                    String?
  faviconUrl                 String?
  primaryColor               String?
  secondaryColor             String?
  accentColor                String?
  supportEmail               String?
  supportPhone               String?
  websiteUrl                 String?
  portalTitle                String?
  aiName                     String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  users                      User[]
  schools                    School[]
  books                      Book[]
  resources                  Resource[]
  series                     BookSeries[]
  boards                     Board[]
  masterDataDefinitions      MasterDataDefinition[]
  masterDataValues           MasterDataValue[]
  inspectionRequests         InspectionRequest[]
  bookAdoptions              SchoolBookAdoption[]
  studentAccessGrants        StudentAccessGrant[]
  studentBookProgress        StudentBookProgress[]
  studentBookBookmarks       StudentBookBookmark[]
  studentAiConversations     StudentAiConversation[]
  assessments                Assessment[]
  assessmentAttempts         AssessmentAttempt[]
  analytics                  StudentAnalytics[]
  subjectAnalytics           StudentSubjectAnalytics[]
  chapterAnalytics           StudentChapterAnalytics[]
  skillAnalytics             StudentSkillAnalytics[]
  learningTimeline           LearningTimeline[]
  publisherAnalytics         PublisherAnalytics[]
  features                   PublisherFeature[]
  teacherAnalytics           TeacherAnalytics[]
  schoolAnalytics            SchoolAnalytics[]
  gapAnalysisRuns            GapAnalysisRun[]
  learningGaps               StudentLearningGap[]
  remedialPlans              RemedialPlan[]
  schoolOnboardingReviews    SchoolOnboardingReview[]
  teacherSchoolRequests      TeacherSchoolRequest[]
  mentors                    Mentor[]
  mentorAssignments          MentorStudentAssignment[]
  mentorSessions             MentorSession[]
  mentorNotes                MentorNote[]
  mentorActivities           MentorActivity[]
  parentInvitations          ParentInvitation[]
  videoLessons               VideoLesson[]
  classMaterials             ClassMaterial[]
  classroomAssignments       ClassroomAssignment[]
  assignmentSubmissions      AssignmentSubmission[]
  schoolBookEntitlements     SchoolBookEntitlement[]
  schoolResourceEntitlements SchoolResourceEntitlement[]
  bookFeatureDefinitions     BookFeatureDefinition[]
  bookResourceLinks          BookResourceLink[]
  dynamicQrCodes             DynamicQrCode[]
}

model FeatureDefinition {
  id          String             @id @default(cuid())
  key         PlatformFeatureKey @unique
  name        String
  description String?
  category    String?
  implemented Boolean            @default(false)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  publishers  PublisherFeature[]
}

model PublisherFeature {
  id          String            @id @default(cuid())
  publisherId String
  featureId   String
  enabled     Boolean           @default(false)
  config      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publisher   Publisher         @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  feature     FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([publisherId, featureId])
  @@index([publisherId, enabled])
}

model SecurityAuditEvent {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  actorUserId   String?
  actorRole     UserRole?
  publisherId   String?
  action        String
  targetType    String
  targetId      String?
  outcome       SecurityAuditOutcome
  reasonCode    String?
  correlationId String               @default(uuid())
  metadata      Json?
  schemaVersion Int                  @default(1)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([publisherId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
}

model Teacher {
  id                          String                     @id @default(cuid())
  userId                      String                     @unique
  schoolName                  String
  schoolId                    String?
  designation                 String
  subject                     String
  classes                     String
  verified                    Boolean                    @default(false)
  active                      Boolean                    @default(true)
  status                      TeacherOnboardingStatus    @default(APPROVED)
  bookmarks                   Bookmark[]
  downloads                   Download[]
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                      School?                    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  aiGenerations               AiGeneration[]
  promptTemplates             PromptTemplate[]
  aiPlan                      TeacherAiPlan              @default(STANDARD)
  aiDailyLimit                Int                        @default(0)
  aiPlanExpiresAt             DateTime?
  aiUsage                     AiUsage[]
  assignments                 TeacherAssignment[]
  classMaterials              ClassMaterial[]
  classroomAssignments        ClassroomAssignment[]
  gradedAssignmentSubmissions AssignmentSubmission[]     @relation("AssignmentSubmissionGrader")
  analytics                   TeacherAnalytics[]
  gapReviews                  StudentLearningGapReview[]
  remedialReviews             RemedialPlanReview[]
  schoolRequests              TeacherSchoolRequest[]
  schoolMemberships           SchoolStaffMembership[]

  @@index([schoolId])
  @@index([schoolId, status, active])
}

model AiGeneration {
  id             String          @id @default(cuid())
  teacherId      String
  tool           String
  title          String
  prompt         String
  output         String?
  status         String          @default("DRAFT")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacher        Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  providerCalled Boolean         @default(false)
  quotaConsumed  Boolean         @default(false)
  completedAt    DateTime?
  failureReason  String?
  usage          AiUsage?
  classMaterials ClassMaterial[]

  @@index([teacherId, createdAt])
}

model AiUsage {
  id           String        @id @default(cuid())
  teacherId    String
  generationId String?       @unique
  tool         String
  status       AiUsageStatus @default(RESERVED)
  reservedAt   DateTime      @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  releasedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  generation   AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([teacherId, status, reservedAt])
  @@index([teacherId, consumedAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  tool        String
  prompt      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, updatedAt])
}

model School {
  id                      String                      @id @default(cuid())
  userId                  String                      @unique
  publisherId             String?
  schoolName              String
  city                    String
  state                   String
  principalName           String?
  address                 String?
  pincode                 String?
  logoUrl                 String?
  status                  SchoolOnboardingStatus      @default(APPROVED)
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  inspectionRequests      InspectionRequest[]
  teachers                Teacher[]
  academicYears           AcademicYear[]
  schoolClasses           SchoolClass[]
  students                Student[]
  studentEnrollments      StudentEnrollment[]
  teacherAssignments      TeacherAssignment[]
  bookAdoptions           SchoolBookAdoption[]
  studentAiConversations  StudentAiConversation[]
  assessments             Assessment[]
  assessmentAttempts      AssessmentAttempt[]
  analytics               SchoolAnalytics[]
  learningTimeline        LearningTimeline[]
  publisher               Publisher?                  @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  studentAnalytics        StudentAnalytics[]
  studentSubjectAnalytics StudentSubjectAnalytics[]
  studentChapterAnalytics StudentChapterAnalytics[]
  studentSkillAnalytics   StudentSkillAnalytics[]
  teacherAnalytics        TeacherAnalytics[]
  gapAnalysisRuns         GapAnalysisRun[]
  learningGaps            StudentLearningGap[]
  remedialPlans           RemedialPlan[]
  onboardingReviews       SchoolOnboardingReview[]
  teacherRequests         TeacherSchoolRequest[]
  studentActivationCodes  StudentActivationCode[]
  mentorAssignments       MentorStudentAssignment[]
  mentorSessions          MentorSession[]
  mentorNotes             MentorNote[]
  mentorActivities        MentorActivity[]
  parentInvitations       ParentInvitation[]
  staffMemberships        SchoolStaffMembership[]
  classMaterials          ClassMaterial[]
  classroomAssignments    ClassroomAssignment[]
  assignmentSubmissions   AssignmentSubmission[]
  reportCardSnapshots     ReportCardSnapshot[]
  bookEntitlements        SchoolBookEntitlement[]
  resourceEntitlements    SchoolResourceEntitlement[]

  @@index([publisherId, status])
  @@index([publisherId])
}

model SchoolOnboardingReview {
  id             String                 @id @default(cuid())
  schoolId       String
  publisherId    String
  reviewerUserId String
  fromStatus     SchoolOnboardingStatus
  toStatus       SchoolOnboardingStatus
  reason         String?
  createdAt      DateTime               @default(now())
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  publisher      Publisher              @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  reviewer       User                   @relation("SchoolOnboardingReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([publisherId, createdAt])
  @@index([schoolId, createdAt])
}

model TeacherSchoolRequest {
  id           String                  @id @default(cuid())
  teacherId    String
  schoolId     String
  publisherId  String
  status       TeacherOnboardingStatus @default(PENDING)
  activeKey    String?                 @unique
  reviewedById String?
  reviewedAt   DateTime?
  reason       String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  teacher      Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  publisher    Publisher               @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  reviewedBy   User?                   @relation("TeacherRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([publisherId, status, createdAt])
  @@index([teacherId, createdAt])
}

model InspectionRequest {
  id          String           @id @default(cuid())
  schoolName  String
  teacherName String
  designation String
  mobile      String
  email       String
  state       String
  city        String
  address     String
  message     String?
  bookId      String?
  bookTitle   String
  bookClass   String
  bookSubject String
  bookSeries  String?
  status      InspectionStatus @default(NEW)
  notes       String?
  schoolId    String?
  publisherId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  publisher   Publisher?       @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  @@index([publisherId, createdAt])
}

model Class {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  books     Book[]
  resources Resource[] @relation("ResourceClass")
}

model AcademicYear {
  id                      String                    @id @default(cuid())
  schoolId                String
  name                    String
  startDate               DateTime
  endDate                 DateTime
  active                  Boolean                   @default(true)
  current                 Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  school                  School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes                 SchoolClass[]
  enrollments             StudentEnrollment[]
  teacherAssignments      TeacherAssignment[]
  bookAdoptions           SchoolBookAdoption[]
  studentAccessGrants     StudentAccessGrant[]
  studentBookProgresses   StudentBookProgress[]
  studentBookBookmarks    StudentBookBookmark[]
  studentRevisionProgress StudentRevisionProgress[]
  studentPracticeAttempts StudentPracticeAttempt[]
  studentAiConversations  StudentAiConversation[]
  studentAiUsage          StudentAiUsage[]
  assessments             Assessment[]
  assessmentAttempts      AssessmentAttempt[]
  studentAnalytics        StudentAnalytics[]
  studentSubjectAnalytics StudentSubjectAnalytics[]
  studentChapterAnalytics StudentChapterAnalytics[]
  studentSkillAnalytics   StudentSkillAnalytics[]
  teacherAnalytics        TeacherAnalytics[]
  schoolAnalytics         SchoolAnalytics[]
  learningTimeline        LearningTimeline[]
  gapAnalysisRuns         GapAnalysisRun[]
  learningGaps            StudentLearningGap[]
  remedialPlans           RemedialPlan[]
  mentorAssignments       MentorStudentAssignment[]
  mentorSessions          MentorSession[]
  mentorNotes             MentorNote[]
  mentorActivities        MentorActivity[]
  classMaterials          ClassMaterial[]
  classroomAssignments    ClassroomAssignment[]
  assignmentSubmissions   AssignmentSubmission[]
  reportCardSnapshots     ReportCardSnapshot[]

  @@unique([schoolId, name])
  @@index([schoolId, current, active])
}

model SchoolClass {
  id                   String                @id @default(cuid())
  schoolId             String
  academicYearId       String
  name                 String
  code                 String
  sortOrder            Int                   @default(0)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections             ClassSection[]
  enrollments          StudentEnrollment[]
  teacherAssignments   TeacherAssignment[]
  bookAdoptions        SchoolBookAdoption[]
  assessments          Assessment[]
  classMaterials       ClassMaterial[]
  classroomAssignments ClassroomAssignment[]

  @@unique([academicYearId, code])
  @@index([schoolId, academicYearId, active])
}

model ClassSection {
  id                    String                 @id @default(cuid())
  schoolClassId         String
  name                  String
  code                  String
  capacity              Int?
  room                  String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  schoolClass           SchoolClass            @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subjects              SectionSubject[]
  enrollments           StudentEnrollment[]
  teacherAssignments    TeacherAssignment[]
  bookAdoptions         SchoolBookAdoption[]
  assessments           Assessment[]
  classMaterials        ClassMaterial[]
  classroomAssignments  ClassroomAssignment[]
  assignmentSubmissions AssignmentSubmission[]

  @@unique([schoolClassId, code])
  @@index([schoolClassId, active])
}

model Student {
  id                    String                      @id @default(cuid())
  userId                String?                     @unique
  schoolId              String
  admissionNumber       String
  name                  String
  firstName             String?
  lastName              String?
  displayName           String?
  email                 String?
  phone                 String?
  guardianName          String?
  guardianPhone         String?
  joinDate              DateTime?
  dateOfBirth           DateTime?
  gender                String?
  active                Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  user                  User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  school                School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments           StudentEnrollment[]
  accessGrants          StudentAccessGrant[]
  bookProgress          StudentBookProgress[]
  bookBookmarks         StudentBookBookmark[]
  revisionProgress      StudentRevisionProgress[]
  practiceAttempts      StudentPracticeAttempt[]
  aiConversations       StudentAiConversation[]
  aiUsage               StudentAiUsage[]
  assessmentAttempts    AssessmentAttempt[]
  analytics             StudentAnalytics[]
  subjectAnalytics      StudentSubjectAnalytics[]
  chapterAnalytics      StudentChapterAnalytics[]
  skillAnalytics        StudentSkillAnalytics[]
  learningTimeline      LearningTimeline[]
  gapAnalysisRuns       GapAnalysisRun[]
  learningGaps          StudentLearningGap[]
  remedialPlans         RemedialPlan[]
  activationCodes       StudentActivationCode[]
  mentorAssignments     MentorStudentAssignment[]
  mentorSessions        MentorSession[]
  mentorNotes           MentorNote[]
  mentorActivities      MentorActivity[]
  parentRelationships   ParentStudentRelationship[]
  parentInvitations     ParentInvitation[]
  resourceBookmarks     StudentResourceBookmark[]
  resourceDownloads     StudentResourceDownload[]
  assignmentSubmissions AssignmentSubmission[]
  reportCardSnapshots   ReportCardSnapshot[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, active, name])
}

model StudentActivationCode {
  id                         String                      @id @default(cuid())
  studentId                  String
  schoolId                   String
  codeHash                   String                      @unique
  expiresAt                  DateTime
  usedAt                     DateTime?
  createdById                String
  usedByUserId               String?
  revokedAt                  DateTime?
  createdAt                  DateTime                    @default(now())
  student                    Student                     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school                     School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy                  User                        @relation("ActivationCodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy                     User?                       @relation("ActivationCodeUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  emailVerificationChallenge EmailVerificationChallenge?

  @@index([studentId, usedAt, expiresAt])
  @@index([schoolId, createdAt])
}

model EmailVerificationChallenge {
  id                      String                   @id @default(cuid())
  reference               String                   @unique @default(cuid())
  userId                  String
  purpose                 EmailVerificationPurpose
  codeHash                String                   @unique
  expiresAt               DateTime
  verifiedAt              DateTime?
  consumedAt              DateTime?
  revokedAt               DateTime?
  attemptCount            Int                      @default(0)
  resendCount             Int                      @default(0)
  lastSentAt              DateTime?
  studentActivationCodeId String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  studentActivationCode   StudentActivationCode?   @relation(fields: [studentActivationCodeId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, consumedAt, revokedAt, expiresAt])
  @@index([purpose, createdAt])
}

model PasswordResetChallenge {
  id                  String    @id @default(cuid())
  reference           String    @unique @default(cuid())
  userId              String
  codeHash            String    @unique
  expiresAt           DateTime
  verifiedAt          DateTime?
  consumedAt          DateTime?
  revokedAt           DateTime?
  attemptCount        Int       @default(0)
  resendCount         Int       @default(0)
  lastSentAt          DateTime?
  completionTokenHash String?   @unique
  completionExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, revokedAt, expiresAt])
  @@index([createdAt])
}

model SecurityRequestThrottle {
  id              String               @id @default(cuid())
  keyHash         String               @unique
  kind            SecurityThrottleKind
  requestCount    Int                  @default(0)
  windowStartedAt DateTime
  lastRequestAt   DateTime
  blockedUntil    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([kind, lastRequestAt])
  @@index([blockedUntil])
}

model Parent {
  id            String                      @id @default(cuid())
  userId        String                      @unique
  active        Boolean                     @default(true)
  phone         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  relationships ParentStudentRelationship[]

  @@index([active, createdAt])
}

model ParentStudentRelationship {
  id                    String                   @id @default(cuid())
  parentId              String
  studentId             String
  relationshipType      ParentRelationshipType
  status                ParentRelationshipStatus @default(PENDING)
  activeKey             String?                  @unique
  primaryContact        Boolean                  @default(false)
  canViewLearning       Boolean                  @default(false)
  canManageSubscription Boolean                  @default(false)
  requestedAt           DateTime                 @default(now())
  approvedAt            DateTime?
  approvedById          String?
  rejectedAt            DateTime?
  revokedAt             DateTime?
  revokedById           String?
  decisionReason        String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  parent                Parent                   @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student               Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  approvedBy            User?                    @relation("ParentRelationshipApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  revokedBy             User?                    @relation("ParentRelationshipRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  invitation            ParentInvitation?

  @@index([parentId, status, requestedAt])
  @@index([studentId, status, requestedAt])
}

model ParentInvitation {
  id               String                     @id @default(cuid())
  studentId        String
  schoolId         String
  publisherId      String
  relationshipType ParentRelationshipType
  primaryContact   Boolean                    @default(false)
  targetEmail      String
  targetPhone      String?
  tokenHash        String                     @unique
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdById      String
  usedByUserId     String?
  relationshipId   String?                    @unique
  createdAt        DateTime                   @default(now())
  student          Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  publisher        Publisher                  @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("ParentInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy           User?                      @relation("ParentInvitationUser", fields: [usedByUserId], references: [id], onDelete: Restrict)
  relationship     ParentStudentRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Restrict)

  @@index([studentId, usedAt, revokedAt, expiresAt])
  @@index([schoolId, createdAt])
