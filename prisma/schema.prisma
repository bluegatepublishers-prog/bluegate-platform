generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School?
  teacher   Teacher?
  student   Student?
}

model Teacher {
  id              String              @id @default(cuid())
  userId          String              @unique
  schoolName      String
  schoolId        String?
  designation     String
  subject         String
  classes         String
  verified        Boolean             @default(false)
  active          Boolean             @default(true)
  bookmarks       Bookmark[]
  downloads       Download[]
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school          School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  aiGenerations   AiGeneration[]
  promptTemplates PromptTemplate[]
  aiPlan          TeacherAiPlan       @default(STANDARD)
  aiDailyLimit    Int                 @default(0)
  aiPlanExpiresAt DateTime?
  aiUsage         AiUsage[]
  assignments     TeacherAssignment[]

  @@index([schoolId])
}

model AiGeneration {
  id             String    @id @default(cuid())
  teacherId      String
  tool           String
  title          String
  prompt         String
  output         String?
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  providerCalled Boolean   @default(false)
  quotaConsumed  Boolean   @default(false)
  completedAt    DateTime?
  failureReason  String?
  usage          AiUsage?

  @@index([teacherId, createdAt])
}

model AiUsage {
  id           String        @id @default(cuid())
  teacherId    String
  generationId String?       @unique
  tool         String
  status       AiUsageStatus @default(RESERVED)
  reservedAt   DateTime      @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  releasedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  generation   AiGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([teacherId, status, reservedAt])
  @@index([teacherId, consumedAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  tool        String
  prompt      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, updatedAt])
}

model School {
  id                 String              @id @default(cuid())
  userId             String              @unique
  schoolName         String
  city               String
  state              String
  principalName      String?
  address            String?
  pincode            String?
  logoUrl            String?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspectionRequests InspectionRequest[]
  teachers           Teacher[]
  academicYears      AcademicYear[]
  schoolClasses      SchoolClass[]
  students           Student[]
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
}

model InspectionRequest {
  id          String           @id @default(cuid())
  schoolName  String
  teacherName String
  designation String
  mobile      String
  email       String
  state       String
  city        String
  address     String
  message     String?
  bookId      String?
  bookTitle   String
  bookClass   String
  bookSubject String
  bookSeries  String?
  status      InspectionStatus @default(NEW)
  notes       String?
  schoolId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
}

model Class {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model AcademicYear {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String
  startDate          DateTime
  endDate            DateTime
  active             Boolean             @default(true)
  current            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes            SchoolClass[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, current, active])
}

model SchoolClass {
  id                 String              @id @default(cuid())
  schoolId           String
  academicYearId     String
  name               String
  code               String
  sortOrder          Int                 @default(0)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections           ClassSection[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([academicYearId, code])
  @@index([schoolId, academicYearId, active])
}

model ClassSection {
  id                 String              @id @default(cuid())
  schoolClassId      String
  name               String
  code               String
  capacity           Int?
  room               String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  schoolClass        SchoolClass         @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subjects           SectionSubject[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolClassId, code])
  @@index([schoolClassId, active])
}

model Student {
  id              String              @id @default(cuid())
  userId          String?             @unique
  schoolId        String
  admissionNumber String
  name            String
  email           String?
  dateOfBirth     DateTime?
  gender          String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments     StudentEnrollment[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, active, name])
}

model StudentEnrollment {
  id             String           @id @default(cuid())
  studentId      String
  schoolId       String
  academicYearId String
  schoolClassId  String
  sectionId      String
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass      @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)
  section        ClassSection     @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@unique([sectionId, rollNumber])
  @@index([schoolId, academicYearId, schoolClassId, sectionId, status])
}

model SectionSubject {
  id        String       @id @default(cuid())
  sectionId String
  subjectId String
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  section   ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([sectionId, subjectId])
  @@index([sectionId, active, sortOrder])
}

model TeacherAssignment {
  id             String                @id @default(cuid())
  teacherId      String
  schoolId       String
  academicYearId String
  schoolClassId  String
  sectionId      String
  subjectId      String?
  type           TeacherAssignmentType
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  teacher        Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass           @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)
  section        ClassSection          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject        Subject?              @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([schoolId, academicYearId, sectionId, active])
  @@index([teacherId, active])
}

model Subject {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  sortOrder          Int                 @default(0)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  books              Book[]
  sectionSubjects    SectionSubject[]
  teacherAssignments TeacherAssignment[]
}

model BookSeries {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]
}

model Book {
  id               String         @id @default(cuid())
  title            String
  author           String?
  subtitle         String?
  slug             String         @unique
  isbn             String?
  description      String?
  coverImage       String?
  samplePdf        String?
  publicPreviewPdf String?
  fullBookPdf      String?
  featured         Boolean        @default(false)
  published        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  classId          String
  subjectId        String
  seriesId         String?
  aboutBook        String?
  binding          String?
  board            String?
  dimensions       String?
  edition          String?
  features         String[]       @default([])
  galleryImages    String[]       @default([])
  language         String?
  learningOutcomes String[]       @default([])
  pages            Int?
  price            Decimal?       @db.Decimal(10, 2)
  publicationYear  String?
  publisher        String?
  tableOfContents  String[]       @default([])
  weight           String?
  seoTitle         String?
  seoDescription   String?
  keywords         String[]       @default([])
  class            Class          @relation(fields: [classId], references: [id])
  series           BookSeries?    @relation(fields: [seriesId], references: [id])
  subject          Subject        @relation(fields: [subjectId], references: [id])
  chapters         BookChapter[]
  questions        BookQuestion[]
}

model BookChapter {
  id               String                   @id @default(cuid())
  bookId           String
  chapterNumber    Int
  title            String
  slug             String
  startPage        Int?
  endPage          Int?
  extractedText    String?
  reviewedText     String?
  summary          String?
  keywords         String[]                 @default([])
  approved         Boolean                  @default(false)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  book             Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  questions        BookQuestion[]
  learningOutcomes ChapterLearningOutcome[]
  activities       ChapterActivity[]

  @@unique([bookId, chapterNumber])
  @@unique([bookId, slug])
  @@index([bookId, sortOrder])
}

model BookQuestion {
  id            String      @id @default(cuid())
  bookId        String
  chapterId     String
  questionType  String
  questionText  String
  options       Json?
  correctAnswer String?
  explanation   String?
  marks         Int         @default(1)
  difficulty    String      @default("MEDIUM")
  bloomLevel    String?
  competency    String?
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  book          Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter       BookChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([bookId, chapterId])
  @@index([questionType, difficulty, approved])
}

model ChapterLearningOutcome {
  id         String      @id @default(cuid())
  chapterId  String
  outcome    String
  bloomLevel String?
  competency String?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  chapter    BookChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, sortOrder])
}

model ChapterActivity {
  id               String      @id @default(cuid())
  chapterId        String
  title            String
  objective        String
  materials        String?
  durationMinutes  Int?
  groupType        String?
  instructions     String
  expectedLearning String?
  assessment       String?
  safetyNotes      String?
  approved         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  chapter          BookChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, approved])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String
  subject     String
  classLevel  String
  type        ResourceType
  fileUrl     String
  thumbnail   String?
  featured    Boolean      @default(false)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookmarks   Bookmark[]
  downloads   Download[]
}

model Download {
  id           String   @id @default(cuid())
  teacherId    String
  resourceId   String
  downloadedAt DateTime @default(now())
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id         String   @id @default(cuid())
  teacherId  String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  TEACHER
  SCHOOL
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum TeacherAssignmentType {
  CLASS_TEACHER
  SUBJECT_TEACHER
}

enum TeacherAiPlan {
  STANDARD
  PREMIUM
}

enum AiUsageStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum ResourceType {
  PDF
  PPT
  DOC
  VIDEO
  ZIP
}

enum InspectionStatus {
  NEW
  CONTACTED
  APPROVED
  DISPATCHED
  CLOSED
}
